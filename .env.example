# ── Database ────────────────────────────────────────────────────────────────
# Neon Postgres. Use the `dev` branch locally and `main` in production.
# Create a project at https://console.neon.tech, then copy the pooled
# connection string. It must include `?sslmode=require`.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# The production branch's endpoint (the part of its host before ".c-…" /
# "-pooler"). db:seed, db:clear and verify:timer refuse to run against it
# unless given --production, and db:push labels it. Not a secret.
PRODUCTION_DATABASE_ENDPOINT="ep-xxx"

# ── Auth.js ─────────────────────────────────────────────────────────────────
# Generate with: npx auth secret
AUTH_SECRET=""

# Google OAuth client (type: Web application)
#   https://console.cloud.google.com/apis/credentials
# Authorized redirect URI (dev):  http://localhost:3000/api/auth/callback/google
# Authorized redirect URI (prod): https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Owners, comma-separated. Always allowed to sign in, and the only accounts that
# can invite others (Settings → Access). Everyone else needs an invite.
ALLOWED_EMAILS="you@example.com"

# ── Jobs ────────────────────────────────────────────────────────────────────
# Bearer token guarding /api/cron/reap-sessions. Set the same value in Vercel.
CRON_SECRET=""
